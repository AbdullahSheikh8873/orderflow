# --- Application ---
APP_NAME=OrderFlow
ENVIRONMENT=development
DEBUG=true

# --- Database ---
DATABASE_URL=postgresql+psycopg2://orderflow:orderflow@localhost:5432/orderflow

# --- JWT / Security ---
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- AWS (leave ACCESS KEY/SECRET blank in production; use IAM roles) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=

# --- AWS SQS ---
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/orderflow-order-events
SQS_DLQ_URL=https://sqs.us-east-1.amazonaws.com/123456789012/orderflow-order-events-dlq

# --- AWS SNS ---
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:order-events

# --- AWS S3 ---
S3_BUCKET_NAME=orderflow-documents

# --- Feature flags ---
# When true, AWS calls are skipped/no-op logged instead of making real calls (useful for local dev without AWS)
AWS_DISABLED=true
